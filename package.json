{
  "name": "kickall-ecosystem",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "npx serve Website -p 5500 -c serve.json",
    "dev:netlify": "npx netlify dev",
    "test": "node --test Bot/tests/*.test.js Website/tests/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage Bot/tests/*.test.js Website/tests/*.test.js",
    "test:bot": "node --test Bot/tests/*.test.js",
    "test:website": "node --test Website/tests/*.test.js",
    "lint": "npx eslint .",
    "audit": "npm audit --audit-level=high",
    "verify": "node scripts/build.js"
  },
  "devDependencies": {
    "eslint": "^10.9.1"
  }
}
